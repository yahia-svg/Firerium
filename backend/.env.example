# Copy this file to ".env" (same folder) and fill in the key to switch on AI-written answers.
# Without a key the site still works: AI features fall back to retrieval-only answers and say so.

# AI key. Either kind works; the site detects which one it is:
#   an Anthropic key (sk-ant-...) from https://console.anthropic.com/  -> Claude API directly
#   a Hack Club AI key (sk-hc-...) from https://ai.hackclub.com/      -> their OpenAI-compatible service
# No quotes, no spaces. Keep this file private; it is in .gitignore.
ANTHROPIC_API_KEY=

# Model for every AI feature (default without this line: claude-opus-5-5, the most expensive).
# Measured on this site on 2026-11-13, three live questions each:
#   claude-haiku-5-5,  effort low   4 to 11 s (average 8.5), $0.001 to $0.002 per answer
#   claude-sonnet-5-5, effort low   8 to 11 s (average 9.3), $0.02 to $0.035 per answer, best wording
FLAME_MODEL=claude-haiku-5-5

# How hard the model thinks: low | medium | high. Low is fastest and cheapest.
FLAME_EFFORT=low

# Optional fast mode, Haiku only: skips the model's thinking pass. Answers arrive in 5 to 7 s, but in
# the test it missed one of six experiments on a whole-collection question and once stated a
# hypothesis as a finding.
# FLAME_THINKING=off

# Optional. Any other OpenAI-compatible service: its base URL, with the key in FLAME_API_KEY.
# FLAME_API_BASE=https://example.com/v1
# FLAME_API_KEY=
